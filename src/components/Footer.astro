---
import { DISCORD_URL } from '../lib/links';
import { getLangFromURL, useTranslation, useTranslatedPath } from '../i18n/utils';
import type { routes, ui } from '../i18n/ui';
import { Icon } from 'astro-icon/components';

const language = getLangFromURL(Astro.url);
const translation = useTranslation(language);
const translatePath = useTranslatedPath(language);

interface NavItem {
  key: keyof typeof routes.ro;
  label: keyof typeof ui.ro;
}

// Coloana "Resurse" din designul Figma (Footer-Dark / Footer-Light).
const resourceItems: NavItem[] = [
  { key: 'catalog', label: 'nav.catalog' },
  { key: 'onboarding', label: 'nav.onboarding' },
  { key: 'mentors', label: 'nav.mentors' },
];

// Coloana "Legal" din design (Politica de Confidentialitate, Termeni si Conditii, Cookie-uri)
// apare cand exista paginile si textul lor, aprobate de asociatie. Pana atunci nu afisam linkuri moarte.
const legalItems: Array<{ href: string; label: string }> = [];

const linkClass =
  'text-base font-semibold tracking-wide text-primary-light transition-colors duration-300 hover:text-green-700 dark:text-pastel-blue-200 dark:hover:text-white';
const headingClass =
  'mb-3 text-xl font-bold uppercase tracking-[0.7px] text-primary-light dark:text-primary-dark';
const iconClass =
  'rounded-full p-1 text-primary-light transition-colors duration-300 hover:bg-beige-600/40 hover:text-green-700 dark:text-primary-dark dark:hover:bg-dark-400/40 dark:hover:text-pastel-blue-200';
---

<footer
  class="mt-auto border-t border-beige-700 bg-beige-500 px-9 py-6 transition-colors duration-300 dark:border-dark-400 dark:bg-dark-500"
>
  <div class="flex flex-wrap items-start justify-between gap-x-10 gap-y-8">
    <p class="w-64 text-left text-base leading-relaxed opacity-90 dark:text-pastel-blue-200">
      {translation('footer.description')}
    </p>

    <div>
      <h3 class={headingClass}>{translation('footer.resources')}</h3>
      <ul class="flex flex-col items-start gap-3">
        {
          resourceItems.map((item) => (
            <li>
              <a href={translatePath(item.key)} class={linkClass}>
                {translation(item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      legalItems.length > 0 && (
        <div>
          <h3 class={headingClass}>Legal</h3>
          <ul class="flex flex-col items-start gap-3">
            {legalItems.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div>
      <h3 class={headingClass}>{translation('footer.contactHeading')}</h3>
      <a href={translatePath('get-involved')} class={linkClass}>
        {translation('footer.contactLink')}
      </a>
      <div class="mt-3 flex flex-row gap-4">
        <a
          href={DISCORD_URL}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Discord"
          class={iconClass}
        >
          <Icon name="ri:discord-fill" class="h-8 w-8" />
        </a>
        <a
          href="https://www.linkedin.com/company/asociatia-oportunitati-si-cariere/posts/?feedView=all"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class={iconClass}
        >
          <Icon name="ri:linkedin-fill" class="h-8 w-8" />
        </a>
      </div>
    </div>
  </div>
</footer>
