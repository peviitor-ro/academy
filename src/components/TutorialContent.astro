---
import { render } from 'astro:content';
import VideoEmbed from './VideoEmbed.astro';
import {
  getSeriesNav,
  getSeriesSlug,
  getTutorials,
  getTutorialSlug,
  type Tutorial,
} from '../lib/tutorials';
import { useTranslation, useTranslatedPath } from '../i18n/utils';

interface Props {
  entry: Tutorial;
  lang: 'ro' | 'en';
}

const { entry, lang } = Astro.props;
const t = useTranslation(lang);
const translatePath = useTranslatedPath(lang);
const { Content } = await render(entry);

const all = await getTutorials(lang);
const { lessons, previous, next } = getSeriesNav(entry, all);
const hrefOf = (tutorial: Tutorial) => `${translatePath('tutorials')}/${getTutorialSlug(tutorial)}/`;
const { title, series, videoUrl, durationMin, author, updated } = entry.data;
const editUrl = entry.filePath
  ? `https://github.com/peviitor-ro/academy/edit/main/${entry.filePath}`
  : undefined;
const dateFormatter = new Intl.DateTimeFormat(lang === 'ro' ? 'ro-RO' : 'en-GB', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
const linkClass = 'underline hover:text-green-700 dark:hover:text-pastel-blue-200';
---

<div class="mx-auto max-w-6xl px-6 pt-8">
  <a
    href={`${translatePath('series')}/${getSeriesSlug(entry)}/`}
    class="inline-flex items-center gap-2 text-2xl font-bold tracking-[0.7px] text-green-600 hover:underline dark:text-blue-400"
  >
    <span aria-hidden="true">‹</span>
    {t('tutorial.toc')}
  </a>
</div>

<div class="mx-auto grid max-w-6xl gap-8 p-6 lg:grid-cols-[18rem_1fr]">
  <aside class="lg:order-1">
    <nav aria-label={`${t('tutorial.series')}: ${series}`} class="lg:sticky lg:top-6">
      <p class="mb-1 text-xs font-semibold uppercase tracking-wide">{t('tutorial.series')}</p>
      <h2 class="mb-1 text-lg font-bold">
        <a href={`${translatePath('series')}/${getSeriesSlug(entry)}/`} class="hover:underline">{series}</a>
      </h2>
      <p
        class="mb-3 text-xs"
        data-series-ids={lessons.map((lesson) => lesson.id).join(',')}
        data-label={t('progress.lessonsSeen')}
      >
      </p>
      <ol class="flex flex-col gap-1">
        {
          lessons.map((lesson) => (
            <li>
              <a
                href={hrefOf(lesson)}
                aria-current={lesson.id === entry.id ? 'page' : undefined}
                class={`block rounded-lg px-3 py-2 text-sm transition-colors duration-300 ${
                  lesson.id === entry.id
                    ? 'bg-green-100 font-semibold text-green-800 dark:bg-dark-400 dark:text-pastel-blue-300'
                    : 'hover:bg-beige-300 dark:hover:bg-dark-600'
                }`}
              >
                {lesson.data.order}. {lesson.data.title}
                <span data-seen-id={lesson.id} hidden aria-label={t('progress.seen')}>
                  {' '}
                  ✓
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <a href={translatePath('catalog')} class={`mt-4 inline-block text-sm ${linkClass}`}>
        ← {t('tutorial.backToCatalog')}
      </a>
    </nav>
  </aside>

  <article class="min-w-0 lg:order-2" data-pagefind-body>
    <p data-pagefind-ignore class="mb-3 text-xs font-semibold tracking-[0.6px] text-green-600 dark:text-primary-dark">
      {series}
    </p>
    <h1 class="mb-3 text-4xl leading-[1.2] font-bold tracking-[-0.8px] text-green-600 dark:text-primary-dark">
      {title}
    </h1>
    <p data-pagefind-ignore class="mb-6 text-sm text-beige-800 dark:text-dark-200">
      {author}
      {durationMin && ` · ${durationMin} ${t('tutorial.minutes')}`}
      {updated && ` · ${t('tutorial.updated')} ${dateFormatter.format(updated)}`}
    </p>

    {videoUrl && <VideoEmbed url={videoUrl} lang={lang} />}

    <div class="lesson-body">
      <Content />
    </div>

    <button
      type="button"
      data-pagefind-ignore
      data-progress-button={entry.id}
      data-label-todo={t('progress.markDone')}
      data-label-done={t('progress.markUndone')}
      aria-pressed="false"
      class="mt-8 cursor-pointer rounded-lg border border-green-500 px-4 py-2 text-sm font-semibold transition-colors duration-300 hover:bg-beige-300 aria-pressed:bg-green-500 aria-pressed:text-beige-50 dark:border-pastel-blue-500 dark:hover:bg-dark-600 dark:aria-pressed:bg-blue-500 dark:aria-pressed:text-white"
    >
      {t('progress.markDone')}
    </button>

    <nav data-pagefind-ignore class="mt-10 flex flex-wrap justify-between gap-4 border-t border-beige-700 pt-6 dark:border-dark-400">
      {
        previous ? (
          <a href={hrefOf(previous)} class={linkClass}>
            ← {t('tutorial.previous')}: {previous.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a
            href={hrefOf(next)}
            class="inline-flex items-center gap-2 rounded-full bg-green-500 px-6 py-3 text-sm font-semibold tracking-[0.7px] text-beige-50 shadow-sm transition-colors duration-300 hover:bg-green-600 dark:bg-blue-500 dark:text-white dark:hover:bg-blue-400"
          >
            {t('tutorial.next')}: {next.data.title} →
          </a>
        )
      }
    </nav>

    <p data-pagefind-ignore class="mt-8 flex flex-wrap gap-4 text-sm text-beige-800 dark:text-dark-200">
      {
        editUrl && (
          <a href={editUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
            {t('tutorial.editOnGithub')}
          </a>
        )
      }
      <span>{t('tutorial.license')}</span>
    </p>
  </article>
</div>

<script>
  import '../scripts/progress-ui';
</script>

<style is:global>
  .lesson-body {
    line-height: 1.75;
  }
  .lesson-body > * + * {
    margin-top: 1rem;
  }
  .lesson-body h2 {
    margin-top: 2rem;
    font-size: 1.5rem;
    font-weight: 700;
  }
  .lesson-body h3 {
    margin-top: 1.5rem;
    font-size: 1.2rem;
    line-height: 1.4;
    font-weight: 700;
  }
  .lesson-body img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }
  /* Intrebari de verificare: <details><summary>Intrebare</summary>Raspuns</details> */
  .lesson-body details {
    padding: 0.75rem 1rem;
    border: 1px solid rgb(128 128 128 / 0.35);
    border-radius: 0.75rem;
  }
  .lesson-body details + details {
    margin-top: 0.5rem;
  }
  .lesson-body summary {
    cursor: pointer;
    font-weight: 600;
  }
  .lesson-body details[open] summary {
    margin-bottom: 0.5rem;
  }
  .lesson-body ul,
  .lesson-body ol {
    padding-left: 1.5rem;
  }
  .lesson-body ul {
    list-style: disc;
  }
  .lesson-body ol {
    list-style: decimal;
  }
  .lesson-body a {
    text-decoration: underline;
  }
  .lesson-body :not(pre) > code {
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    background: rgb(128 128 128 / 0.2);
    font-size: 0.9em;
  }
  .dark .lesson-body :not(pre) > code {
    background: rgb(137 131 238 / 0.08);
    color: #8983ee;
  }
  .lesson-body pre {
    padding: 1rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    font-size: 0.9rem;
  }
  /* Citat obisnuit */
  .lesson-body blockquote {
    padding-left: 1rem;
    border-left: 4px solid currentColor;
    opacity: 0.85;
  }
  /* Callout-uri din Figma: `> [!TIP]` = Pro Tip, `> [!NOTE]` = Key Concepts. */
  .lesson-body .callout {
    padding: 1rem 1.25rem;
  }
  .lesson-body .callout > * + * {
    margin-top: 0.5rem;
  }
  .lesson-body .callout-title {
    font-weight: 700;
  }
  .lesson-body .callout-tip {
    border-left: 4px solid #4f46e5;
    border-radius: 0 8px 8px 0;
    background: rgb(79 70 229 / 0.10);
  }
  .lesson-body .callout-note {
    border: 1px solid #4f46e5;
    border-radius: 12px;
    background: rgb(79 70 229 / 0.10);
  }
  .lesson-body .callout-note .callout-title {
    font-size: 1.5rem;
    font-weight: 600;
  }
  .dark .lesson-body .callout-tip {
    border-left-color: #8983ee;
    background: rgb(137 131 238 / 0.10);
  }
  .dark .lesson-body .callout-note {
    border-color: #8983ee;
    background: rgb(137 131 238 / 0.08);
  }
  .lesson-body img {
    max-width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }
</style>
