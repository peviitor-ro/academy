---
import { DISCORD_URL } from '../lib/links';
import PageBackdrop from './ui/PageBackdrop.astro';
import { buttonClass, cardClass, eyebrowClass, gradientTextClass } from './ui/styles';
import { mentors } from '../data/mentors';
import { useTranslatedPath } from '../i18n/utils';

interface Props {
  lang: 'ro' | 'en';
}

const { lang } = Astro.props;
const translatePath = useTranslatedPath(lang);

const copy = {
  ro: {
    eyebrow: 'Comunitate',
    title: 'Învață de la comunitate',
    text: 'Îndrumare de la voluntari cu experiență din comunitatea peViitor: întrebări despre cod, carieră și primii pași în open source.',
    contact: 'Contactează-ne',
    listTitle: 'Mentorii noștri',
    all: 'Toate',
    filter: 'Filtrează după etichetă',
    profile: 'Vezi profilul',
    emptyTitle: 'Lista mentorilor se completează',
    emptyText: 'Mentorii apar aici după ce își dau acordul să fie afișați public. Până atunci, întreabă în comunitate pe Discord.',
    discord: 'Intră pe Discord',
    becomeTitle: 'Devino mentor',
    becomeText: 'Împărtășește ce știi și ajută-i pe cei care abia încep.',
    becomeCta: 'Aplică',
  },
  en: {
    eyebrow: 'Community',
    title: 'Learn from the community',
    text: 'Guidance from experienced volunteers in the peViitor community: questions about code, career and first steps in open source.',
    contact: 'Get in touch',
    listTitle: 'Our mentors',
    all: 'All',
    filter: 'Filter by tag',
    profile: 'View profile',
    emptyTitle: 'The mentor list is being put together',
    emptyText: 'Mentors appear here once they agree to be listed publicly. Until then, ask in the community on Discord.',
    discord: 'Join Discord',
    becomeTitle: 'Become a mentor',
    becomeText: 'Share what you know and help people who are just starting.',
    becomeCta: 'Apply',
  },
}[lang];

const tags = [...new Set(mentors.flatMap((m) => m.tags))].sort((a, b) => a.localeCompare(b, lang));
const involved = translatePath('get-involved');

const card = `${cardClass} p-6`;
const primaryButton = buttonClass('primary');
const secondaryButton = buttonClass('secondary', 'sm');
const chipBase =
  'rounded-full border px-3 py-1 text-xs font-semibold transition aria-pressed:border-blue-500 aria-pressed:bg-blue-500/15';
---

<div class="relative overflow-hidden">
  <PageBackdrop />

  <section class="mx-auto max-w-3xl px-6 pt-12 pb-14 text-center md:pt-16">
    <p class={`mb-4 ${eyebrowClass}`}>{copy.eyebrow}</p>
    <h1 class={`text-4xl leading-tight font-extrabold tracking-tight md:text-6xl ${gradientTextClass}`}>
      {copy.title}
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-green-600 dark:text-dark-100">{copy.text}</p>
    <div class="mt-8">
      <a href={involved} class={primaryButton}>{copy.contact}</a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <h2 class="mb-6 text-2xl font-bold md:text-3xl dark:text-white">{copy.listTitle}</h2>

    {mentors.length > 0 && tags.length > 0 && (
      <div id="mentor-filters" class="mb-6 flex flex-wrap gap-2" role="group" aria-label={copy.filter}>
        <button type="button" data-tag="" aria-pressed="true" class={`${chipBase} border-beige-600 dark:border-white/20`}>{copy.all}</button>
        {tags.map((tag) => (
          <button type="button" data-tag={tag} aria-pressed="false" class={`${chipBase} border-beige-600 dark:border-white/20`}>{tag}</button>
        ))}
      </div>
    )}

    <ul class="grid gap-4 md:grid-cols-2">
      {mentors.map((mentor) => (
        <li class={card} data-tags={JSON.stringify(mentor.tags)}>
          <div class="mb-3 flex items-center gap-3">
            <span aria-hidden="true" class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-blue-400 to-blue-600 font-bold text-white">
              {mentor.name.split(' ').map((part) => part[0]).slice(0, 2).join('').toUpperCase()}
            </span>
            <div class="min-w-0">
              <h3 class="truncate text-lg font-bold">{mentor.name}</h3>
              <p class="text-xs font-semibold tracking-wide text-blue-700 uppercase dark:text-pastel-blue-500">{mentor.role}</p>
            </div>
          </div>
          <p class="text-sm text-green-600 dark:text-dark-100">{mentor.bio}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {mentor.tags.map((tag) => (
              <li class="rounded-md bg-beige-600/70 px-2 py-0.5 text-xs dark:bg-white/10">{tag}</li>
            ))}
          </ul>
          {mentor.url && (
            <a href={mentor.url} target="_blank" rel="noopener noreferrer" class={`${secondaryButton} mt-5`}>{copy.profile}</a>
          )}
        </li>
      ))}

      {mentors.length === 0 && (
        <li class={`${card} md:col-span-2`}>
          <h3 class="mb-2 text-lg font-bold">{copy.emptyTitle}</h3>
          <p class="mb-5 text-sm text-green-600 dark:text-dark-100">{copy.emptyText}</p>
          <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class={secondaryButton}>{copy.discord}</a>
        </li>
      )}

      <li class={`${card} md:col-span-2`}>
        <h3 class="mb-1 text-lg font-bold">{copy.becomeTitle}</h3>
        <p class="mb-5 text-sm text-green-600 dark:text-dark-100">{copy.becomeText}</p>
        <a href={involved} class={secondaryButton}>{copy.becomeCta}</a>
      </li>
    </ul>
  </section>
</div>

<script>
  const filters = document.getElementById('mentor-filters');
  const cards = document.querySelectorAll<HTMLElement>('li[data-tags]');
  filters?.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('button[data-tag]');
    if (!button) return;
    const tag = button.dataset.tag ?? '';
    filters.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    cards.forEach((card) => {
      const tags: string[] = JSON.parse(card.dataset.tags ?? '[]');
      card.hidden = tag !== '' && !tags.includes(tag);
    });
  });
</script>
