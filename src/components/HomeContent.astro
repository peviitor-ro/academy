---
import { REPO_URL } from '../lib/links';
import PageBackdrop from './ui/PageBackdrop.astro';
import { buttonClass, cardClass, eyebrowClass } from './ui/styles';
import TutorialCard from './TutorialCard.astro';
import { DOMAINS } from '../content.config';
import { getSeries, getTutorialSlug, getTutorials } from '../lib/tutorials';
import { useTranslation, useTranslatedPath } from '../i18n/utils';

interface Props {
  lang: 'ro' | 'en';
}

const { lang } = Astro.props;
const t = useTranslation(lang);
const translatePath = useTranslatedPath(lang);

const tutorials = await getTutorials(lang);
const allSeries = getSeries(tutorials);
const featured = allSeries[0];
const latest = tutorials.slice(0, 6);
const lessonHref = (entry: (typeof tutorials)[number]) =>
  `${translatePath('tutorials')}/${getTutorialSlug(entry)}/`;
const seriesHref = (slug: string) => `${translatePath('series')}/${slug}/`;

const domainCounts = DOMAINS.map((domain) => ({
  domain,
  count: tutorials.filter((entry) => entry.data.domain === domain).length,
}));

// Lista ordonata a lectiilor, folosita de cardul "Continua de unde ai ramas".
const ordered = allSeries.flatMap((series) =>
  (series.project ? [...series.lessons, series.project] : series.lessons).map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    series: series.name,
    href: lessonHref(entry),
  })),
);

const featuredEntries = featured ? (featured.project ? [...featured.lessons, featured.project] : featured.lessons) : [];
const featuredIds = featuredEntries.map((entry) => entry.id).join(',');
const catalogPath = translatePath('catalog');

const card = cardClass;
const eyebrow = eyebrowClass;
const primaryButton = buttonClass('primary');
const secondaryButton = buttonClass('secondary');
---

<div class="relative overflow-hidden dark:[&_h1]:text-white dark:[&_h2]:text-white">
  {/* Fundal: grila, doua lumini discrete pe margini si campul de particule. Decorativ, ascuns cititoarelor de ecran. */}
  <canvas id="particle-field" aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 h-screen w-screen"></canvas>
  <PageBackdrop />

  {/* Hero */}
  <section class="mx-auto max-w-5xl px-6 pt-10 pb-16 text-center md:pt-16">
    <p class="mb-8 inline-flex items-center gap-2 rounded-full border border-blue-500/40 bg-pastel-blue-500/20 px-3 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-blue-700 dark:border-pastel-blue-500/40 dark:text-pastel-blue-500">
      <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8 12l3 3 5-6" /></svg>
      {t('home.badge')}
    </p>

    <h1 class="text-4xl leading-[1.1] font-extrabold tracking-tight md:text-6xl">
      {t('home.title.line1')}<br />
      <span class="bg-gradient-to-r from-blue-500 via-blue-300 to-blue-600 bg-clip-text text-transparent dark:from-pastel-blue-500 dark:via-blue-400 dark:to-blue-300">
        {t('home.title.line2')}
      </span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg text-green-600 dark:text-dark-100">{t('home.subtitle')}</p>

    {allSeries.length > 0 && (
      <div class="relative mx-auto mt-10 max-w-3xl" id="home-carousel" role="region" aria-roledescription="carousel" aria-label={t('home.carousel.label')}>
        <ul class="flex snap-x snap-mandatory overflow-x-auto rounded-2xl border border-beige-600 [scrollbar-width:none] dark:border-white/10 [&::-webkit-scrollbar]:hidden" data-track>
          {allSeries.map((series) => (
            <li class="relative aspect-[21/9] w-full shrink-0 snap-center">
              <a href={seriesHref(series.slug)} class="absolute inset-0 flex flex-col justify-end bg-gradient-to-br from-blue-600 via-blue-500 to-dark-500 p-8 text-left">
                <span class="mb-1 font-mono text-xs uppercase tracking-widest text-pastel-blue-500">{series.lessons.length + (series.project ? 1 : 0)} {t('series.lessons')}</span>
                <span class="text-3xl font-extrabold text-white md:text-4xl">{series.name}</span>
              </a>
            </li>
          ))}
        </ul>
        {allSeries.length > 1 && (
          <>
            <button type="button" data-prev aria-label={t('home.carousel.prev')} class="absolute top-1/2 left-3 -translate-y-1/2 rounded-full bg-dark-500/60 px-3 py-2 text-white backdrop-blur hover:bg-dark-500">‹</button>
            <button type="button" data-next aria-label={t('home.carousel.next')} class="absolute top-1/2 right-3 -translate-y-1/2 rounded-full bg-dark-500/60 px-3 py-2 text-white backdrop-blur hover:bg-dark-500">›</button>
            <div class="absolute bottom-3 left-1/2 flex -translate-x-1/2 gap-1.5" aria-hidden="true">
              {allSeries.map((_, i) => <span data-dot class={`h-1.5 rounded-full bg-white/60 transition-all ${i === 0 ? 'w-6 bg-white' : 'w-1.5'}`}></span>)}
            </div>
          </>
        )}
      </div>
    )}

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href={catalogPath} class={primaryButton}>{t('home.cta.start')}</a>
      <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class={secondaryButton}>
        {t('home.cta.github')}
      </a>
    </div>

    {/* Apare doar dupa ce JS-ul citeste progresul din browser. */}
    {ordered.length > 0 && (
      <div
        id="home-continue"
        hidden
        data-lessons={JSON.stringify(ordered)}
        data-label-start={t('home.continue.start')}
        data-label-next={t('home.continue.next')}
        class={`${card} mx-auto mt-10 max-w-xl p-4 text-left`}
      >
        <p class="font-mono text-xs uppercase tracking-[0.2em] text-blue-700 dark:text-pastel-blue-500" id="home-continue-label"></p>
        <a id="home-continue-link" href="#" class="mt-1 block text-lg font-semibold hover:underline"></a>
        <p id="home-continue-series" class="text-sm text-green-500 dark:text-dark-200"></p>
      </div>
    )}
  </section>

  {/* Trei motive */}
  <section class="mx-auto grid max-w-6xl gap-4 px-6 pb-20 md:grid-cols-3">
    {[
      { key: 'video', icon: '▶' },
      { key: 'free', icon: '◎' },
      { key: 'community', icon: '✦' },
    ].map((feature) => (
      <div class={`${card} reveal p-6`}>
        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-blue-500/15 text-blue-700 dark:text-pastel-blue-500" aria-hidden="true">
          {feature.icon}
        </span>
        <h2 class="mb-2 text-lg font-semibold">{t(`home.feature.${feature.key}.title` as any)}</h2>
        <p class="text-sm text-green-600 dark:text-dark-100">{t(`home.feature.${feature.key}.text` as any)}</p>
      </div>
    ))}
  </section>

  {/* Domenii */}
  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="reveal mb-8 text-center">
      <h2 class="text-3xl font-bold md:text-4xl">{t('home.domains.title')}</h2>
      <p class="mt-2 text-green-600 dark:text-dark-100">{t('home.domains.subtitle')}</p>
    </div>
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-4">
      {domainCounts.map(({ domain, count }) => (
        <li class="reveal">
          {count > 0 ? (
            <a
              href={`${catalogPath}?domain=${domain}`}
              class={`${card} block h-full p-5 transition hover:-translate-y-0.5 hover:border-blue-500 dark:hover:border-pastel-blue-500`}
            >
              <span class="block font-semibold">{t(`domain.${domain}` as any)}</span>
              <span class="mt-1 block text-sm text-green-500 dark:text-dark-200">
                {count} {t('series.lessons')}
              </span>
            </a>
          ) : (
            <div class={`${card} h-full p-5 opacity-60`}>
              <span class="block font-semibold">{t(`domain.${domain}` as any)}</span>
              <span class="mt-1 block text-sm text-green-500 dark:text-dark-200">{t('home.domains.soon')}</span>
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>

  {/* Parcurs: seria reala cu progres */}
  {featured && (
    <section class="mx-auto grid max-w-6xl items-center gap-10 px-6 pb-20 md:grid-cols-2">
      <div class="reveal">
        <p class={`${eyebrow} mb-3`}>{t('home.path.eyebrow')}</p>
        <h2 class="mb-4 text-3xl font-bold md:text-4xl">{t('home.path.title')}</h2>
        <p class="mb-6 text-green-600 dark:text-dark-100">{t('home.path.text')}</p>
        <a href={seriesHref(featured.slug)} class={primaryButton}>{t('home.path.open')}</a>
      </div>
      <div class={`${card} reveal p-6`}>
        <div class="mb-1 flex items-baseline justify-between gap-4">
          <h3 class="text-lg font-semibold">{featured.name}</h3>
          <span class="text-xs font-semibold" data-series-ids={featuredIds} data-label={t('progress.lessonsSeen')}></span>
        </div>
        <div
          role="progressbar"
          aria-label={t('series.progress')}
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          data-bar-ids={featuredIds}
          class="mb-5 h-2 overflow-hidden rounded-full bg-beige-600 dark:bg-white/10"
        >
          <div class="h-full w-0 rounded-full bg-gradient-to-r from-blue-400 to-blue-600 transition-[width] duration-500"></div>
        </div>
        <ol class="flex flex-col gap-2">
          {featuredEntries.map((entry, index) => (
            <li>
              <a
                href={lessonHref(entry)}
                class="flex items-center gap-3 rounded-xl border border-beige-600 p-3 transition hover:border-blue-500 dark:border-white/10 dark:hover:border-pastel-blue-500"
              >
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-500/15 text-sm font-bold text-blue-700 dark:text-pastel-blue-500">
                  {index + 1}
                </span>
                <span class="min-w-0 flex-1 truncate text-sm font-medium">{entry.data.title}</span>
                <span hidden data-seen-id={entry.id} class="text-sm text-emerald-600 dark:text-emerald-300" aria-label={t('progress.seen')}>✓</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {/* Contributie: terminal cu comenzi reale */}
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-6 pb-20 md:grid-cols-2">
    <div class="reveal order-2 md:order-1">
      <div class="overflow-hidden rounded-2xl border border-dark-400 bg-dark-600 text-dark-50 shadow-xl">
        <div class="flex items-center justify-between border-b border-white/10 px-4 py-2">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-red-400/80"></span>
            <span class="h-3 w-3 rounded-full bg-amber-300/80"></span>
            <span class="h-3 w-3 rounded-full bg-emerald-400/80"></span>
          </div>
          <button
            type="button"
            id="copy-commands"
            data-label-copy={t('home.contribute.copy')}
            data-label-copied={t('home.contribute.copied')}
            class="rounded-md border border-white/15 px-2.5 py-1 font-mono text-xs transition hover:border-pastel-blue-500"
          >
            {t('home.contribute.copy')}
          </button>
        </div>
        <pre id="commands" class="overflow-x-auto p-5 font-mono text-sm leading-7"><code><span class="text-green-500">$ </span>git clone https://github.com/peviitor-ro/academy
<span class="text-green-500">$ </span>npm install
<span class="text-green-500">$ </span>npm run dev</code></pre>
      </div>
    </div>
    <div class="reveal order-1 md:order-2">
      <p class={`${eyebrow} mb-3`}>{t('home.contribute.eyebrow')}</p>
      <h2 class="mb-4 text-3xl font-bold md:text-4xl">{t('home.contribute.title')}</h2>
      <p class="mb-6 text-green-600 dark:text-dark-100">{t('home.contribute.text')}</p>
      <a href={translatePath('get-involved')} class={secondaryButton}>{t('home.contribute.link')}</a>
    </div>
  </section>

  {/* Lectii recente */}
  {latest.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 pb-20">
      <div class="reveal mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-3xl font-bold md:text-4xl">{t('home.latest.title')}</h2>
        <a href={catalogPath} class="font-semibold underline hover:text-blue-700 dark:hover:text-pastel-blue-500">
          {t('home.latest.all')} →
        </a>
      </div>
      <ul class="reveal grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {latest.map((entry) => <TutorialCard entry={entry} lang={lang} />)}
      </ul>
    </section>
  )}

  {/* Pentru cine */}
  <section class="mx-auto grid max-w-6xl gap-4 px-6 pb-20 md:grid-cols-2">
    <div class={`${card} reveal p-8`}>
      <h2 class="mb-2 text-2xl font-bold">{t('home.audience.learner.title')}</h2>
      <p class="mb-6 text-green-600 dark:text-dark-100">{t('home.audience.learner.text')}</p>
      <a href={catalogPath} class={primaryButton}>{t('home.cta.catalog')}</a>
    </div>
    <div class={`${card} reveal p-8`}>
      <h2 class="mb-2 text-2xl font-bold">{t('home.audience.volunteer.title')}</h2>
      <p class="mb-6 text-green-600 dark:text-dark-100">{t('home.audience.volunteer.text')}</p>
      <a href={translatePath('get-involved')} class={secondaryButton}>{t('home.audience.volunteer.cta')}</a>
    </div>
  </section>

  {/* Beneficii */}
  <section class="border-y border-beige-600 bg-beige-300/60 py-16 dark:border-white/10 dark:bg-dark-600/60">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="reveal mb-8 text-center text-3xl font-bold text-blue-700 dark:text-pastel-blue-500">{t('home.benefits.title')}</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {([
          ['innovation', 'M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2zM9 21h6'],
          ['remote', 'M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z'],
          ['demand', 'M3 17l6-6 4 4 8-8M15 7h6v6'],
          ['pay', 'M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6'],
        ] as const).map(([key, path]) => (
          <div class="reveal rounded-2xl border border-beige-600 bg-white/70 p-6 dark:border-white/10 dark:bg-dark-400/60">
            <span class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-full bg-blue-500/15 text-blue-600 dark:text-pastel-blue-500">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path} /></svg>
            </span>
            <h3 class="mb-2 text-lg font-bold text-blue-700 dark:text-pastel-blue-500">{t(`home.benefits.${key}.title`)}</h3>
            <p class="text-sm text-green-600 dark:text-dark-100">{t(`home.benefits.${key}.text`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Comunitate */}
  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="reveal rounded-3xl border border-beige-600 bg-white/70 p-10 text-center dark:border-white/10 dark:bg-dark-400/60">
      <h2 class="text-2xl font-bold md:text-3xl">{t('home.community.title')}</h2>
      <p class="mx-auto mt-3 max-w-xl text-green-600 dark:text-dark-100">{t('home.community.text')}</p>
      <dl class="mt-8 flex flex-wrap items-center justify-center gap-10">
        <div><dt class="text-xs font-semibold uppercase tracking-wider text-green-500 dark:text-dark-200">{t('home.community.lessons')}</dt><dd class="text-4xl font-extrabold text-blue-600 dark:text-pastel-blue-500">{tutorials.length}</dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wider text-green-500 dark:text-dark-200">{t('home.community.series')}</dt><dd class="text-4xl font-extrabold text-blue-600 dark:text-pastel-blue-500">{allSeries.length}</dd></div>
        <div><dt class="text-xs font-semibold uppercase tracking-wider text-green-500 dark:text-dark-200">{t('home.community.free')}</dt><dd class="text-4xl font-extrabold text-blue-600 dark:text-pastel-blue-500">100%</dd></div>
      </dl>
      <div class="mt-8">
        <a href={translatePath('get-involved')} class={primaryButton}>{t('home.community.cta')}</a>
      </div>
    </div>
  </section>

  {/* Apel final */}
  <section class="mx-auto max-w-4xl px-6 pb-24 text-center">
    <div class="reveal">
      <h2 class="text-4xl font-extrabold md:text-5xl">{t('home.final.title')}</h2>
      <p class="mx-auto mt-3 max-w-xl text-green-600 dark:text-dark-100">{t('home.final.text')}</p>
      <div class="mt-8">
        <a href={featured && featuredEntries[0] ? lessonHref(featuredEntries[0]) : catalogPath} class={primaryButton}>
          {t('home.cta.catalog')}
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  import '../scripts/progress-ui';
  import '../scripts/particle-field';
  import { progressStore } from '../lib/progress';

  // Aparitii la scroll. Fara JS (sau cu reduced-motion) continutul ramane vizibil.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-reveal');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.12 },
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  }

  // "Continua de unde ai ramas": prima lectie nevazuta, dupa cea mai recenta vazuta.
  const box = document.getElementById('home-continue');
  if (box) {
    type Lesson = { id: string; title: string; series: string; href: string };
    const lessons: Lesson[] = JSON.parse(box.dataset.lessons ?? '[]');
    const done = new Set(progressStore.getDone());
    const lastDone = lessons.reduce((acc, l, i) => (done.has(l.id) ? i : acc), -1);
    const next = lessons.slice(lastDone + 1).find((l) => !done.has(l.id)) ?? lessons.find((l) => !done.has(l.id));
    if (next) {
      const label = document.getElementById('home-continue-label');
      const link = document.getElementById('home-continue-link') as HTMLAnchorElement | null;
      const series = document.getElementById('home-continue-series');
      if (label) label.textContent = done.size > 0 ? (box.dataset.labelNext ?? '') : (box.dataset.labelStart ?? '');
      if (link) {
        link.textContent = next.title;
        link.href = next.href;
      }
      if (series) series.textContent = next.series;
      box.hidden = false;
    }
  }

  // Carusel serii: derulare cu butoane + indicator
  const carousel = document.getElementById('home-carousel');
  const track = carousel?.querySelector<HTMLElement>('[data-track]');
  if (carousel && track) {
    const dots = carousel.querySelectorAll<HTMLElement>('[data-dot]');
    const go = (dir: number) => track.scrollBy({ left: dir * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    carousel.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
    carousel.querySelector('[data-next]')?.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, n) => {
        d.classList.toggle('w-6', n === i);
        d.classList.toggle('bg-white', n === i);
        d.classList.toggle('w-1.5', n !== i);
      });
    }, { passive: true });
  }

  // Copiere comenzi
  const copy = document.getElementById('copy-commands') as HTMLButtonElement | null;
  const commands = document.getElementById('commands');
  copy?.addEventListener('click', async () => {
    const text = (commands?.textContent ?? '').replace(/^\$ /gm, '');
    try {
      await navigator.clipboard.writeText(text);
      copy.textContent = copy.dataset.labelCopied ?? '';
      window.setTimeout(() => (copy.textContent = copy.dataset.labelCopy ?? ''), 1500);
    } catch {
      // Clipboard indisponibil: utilizatorul poate selecta textul manual.
    }
  });
</script>
