---
import Layout from '../../layouts/Layout.astro';
import TutorialContent from '../../components/TutorialContent.astro';
import { getTutorials, getTutorialSlug, type Tutorial } from '../../lib/tutorials';

export async function getStaticPaths() {
  const tutorials = await getTutorials('ro');
  return tutorials.map((entry) => ({
    params: { slug: getTutorialSlug(entry) },
    props: { entry },
  }));
}

interface Props {
  entry: Tutorial;
}

const { entry } = Astro.props;
---

<Layout title={entry.data.title} description={entry.data.description}>
  <TutorialContent entry={entry} lang="ro" />
</Layout>
